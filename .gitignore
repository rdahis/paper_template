.DS_Store

# Build products, regenerated by scons. Anchored to the repo root so that
# code/data/ stays tracked.
/data/
/output/
/tmp/

# SCons build state, per machine
.sconsign.dblite
__pycache__/

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.xdv

# R and editors
.Rproj.user
.Rhistory
.RData
.Rprofile
*.stswp
.env

# pdfcomment aux files and compiled documents (build with scons paper)
*.upa
*.upb
/products/*/main.pdf
